{
  "schema": "hoopvision.public-runner-policy.v5",
  "version": "2026-10-07",
  "execution_entrypoint": "timeedmonds-maker/hoopvision-runner@main",
  "purpose": "Public-safe execution bridge and non-confidential utility surface only.",
  "public_safe_code_allowed": true,
  "opaque_request_only": true,
  "request_id_policy": "req- followed by 32 lowercase hexadecimal characters",
  "commercial_ip_allowed": false,
  "private_source_allowed": false,
  "private_data_allowed": false,
  "private_fixture_allowed": false,
  "private_evidence_allowed": false,
  "model_or_checkpoint_allowed": false,
  "credentials_allowed": false,
  "cloud_topology_allowed": false,
  "detailed_private_result_allowed": false,
  "public_gcp_control_allowed": false,
  "sanitized_terminal_result_allowed": true,
  "public_payload_fields": [
    "request_id"
  ],
  "allowed_public_content_classes": [
    "bridge orchestration",
    "generic privacy/security validation",
    "synthetic non-product fixtures",
    "public-source utilities that reveal no CourtCoder implementation or evaluation state"
  ],
  "forbidden_public_content_classes": [
    "private application source",
    "private model weights or checkpoints",
    "private or retained evaluation data",
    "private fixture identity or footage",
    "algorithm-specific experiment inputs or outputs tied to the private engine",
    "private source revisions or branch identities",
    "cloud project, bucket, service-account, build, operation, region or topology identifiers",
    "credentials, tokens or authentication material",
    "detailed private logs, failure traces or acceptance evidence"
  ],
  "compute": "github_hosted_cpu_bridge_only",
  "gpu_allowed": false,
  "private_source_checkout_allowed": false,
  "pat_allowed": false,
  "service_account_key_allowed": false,
  "active_authentication": "none_in_public_repo",
  "active_transport": "public_outbox_private_pull",
  "preferred_transport": "public_outbox_private_pull",
  "oidc_migration_status": "STAGED_ALTERNATIVE_NOT_ACTIVE_OR_CANONICAL",
  "private_execution": {
    "automatic_registration": true,
    "exactly_once_dispatch": true,
    "private_source_and_evidence_only": true,
    "public_side_authorizes_workload": false,
    "private_side_authorization_required": true,
    "public_direct_gpu_dispatch_allowed": false
  },
  "public_observation": {
    "consumer_receipt_allowed": true,
    "execution_status_allowed": true,
    "sanitized_terminal_result_allowed": true,
    "detailed_private_result_allowed": false,
    "private_source_ref_allowed": false,
    "private_build_id_allowed": false,
    "private_operation_name_allowed": false,
    "allowed_result_summary_fields": [
      "schema",
      "request_id",
      "status",
      "result_available",
      "observed_at_utc"
    ]
  },
  "security": {
    "public_repo_never_receives_private_source": true,
    "public_repo_never_receives_private_fixture_data": true,
    "public_repo_never_receives_private_bucket_paths": true,
    "public_repo_never_publishes_private_build_or_operation_ids": true,
    "public_repo_has_no_gcp_credentials": true,
    "result_sanitization_required": true,
    "public_content_guard_required": true,
    "actions_artifact_upload_for_engine_data_forbidden": true,
    "semantic_request_ids_forbidden": true
  }
}
